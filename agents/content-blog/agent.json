{
  "name": "content-blog",
  "schedule": ["daily 05:00"],
  "inputs": [],
  "meta": {
    "projects": ["termstack", "publishpilot"],
    "config": "projects/{task.project}/config.json",
    "lead": "4d",
    "note": "repo, branches, preview url and voice are per-project. Read the config, never hardcode."
  },
  "steps": [
    { "do": "branch",     "gate": "auto" },
    { "do": "draft",      "gate": "auto" },
    { "do": "fact_check", "gate": "auto" },
    { "do": "build",      "to": "{project.repo}", "run": "{project.build_skills}" },
    { "do": "qa_image",   "gate": "auto" },
    { "do": "commit",     "gate": "auto" },
    { "do": "deliver",    "to": ["git_pr:merge"], "gate": "auto" },
    { "do": "promote",  "to": ["git_pr:prod"],  "gate": "auto" },
    { "do": "notify",     "to": "me" }
  ]
}