# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Hunter.io — used ONLY by the on-demand enrich skill (agents/outreach/skills/enrich.md).
# Free/Starter/Growth plan key from https://hunter.io/api-keys
HUNTER_API_KEY=

# Linear — the board. Personal API key from Settings > Security & access > API keys.
# Read/write on issues and comments. Used by engine/linear and agents/board.
LINEAR_API_KEY=

# Slack — NOT IN USE. Notifications go by iMessage (engine/imessage/send.sh) and answers
# arrive only as comments on the Linear card, so the card is always the complete record.
# engine/slack/ is kept dormant for the day a second person needs a shared channel.
# Leave these unset; setting them wires up nothing on their own.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# External watchdog — a URL that something OTHER than this Mac is watching.
# If pings stop arriving, it emails you. See ops/heartbeat.sh.
HEARTBEAT_PING_URL=
